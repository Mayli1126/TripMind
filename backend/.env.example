# ============================================================
# LLM 配置（OpenAI 兼容端点，如阿里云 MaaS）
# ============================================================
# 主模型（研究类 Agent 与默认兜底）
LLM_MODEL_ID=your-model-name
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=your-api-base-url
# 超时时间（可选，默认60秒）
LLM_TIMEOUT=60
# 多日行程JSON较长，低于8192容易被截断并触发降级
LLM_MAX_TOKENS=8192

# 生成提速：精简骨架调用；收尾不再额外等模型，可改 llm 恢复润色
SKELETON_DIRECT_ENABLED=true
PLANNING_TIPS_MODE=rules
# 单次执行的总时限；超时终止独立执行器，Redis按退避策略重试
PLANNING_JOB_TIMEOUT_SECONDS=900
# 地图营业时间缓存；官方预约政策适配服务未配置时明确显示待核实
ADVISORY_CACHE_HOURS=6
ADVISORY_PROVIDER_URL=
ADVISORY_OFFICIAL_HOSTS=

# 市内道路耗时：复用AMAP_API_KEY；查询失败明确估算。15分钟进程缓存。
ROAD_ROUTES_ENABLED=true
# 单次构建最多24次查询，12秒后不发起新查询；单请求各网络阶段超时最多2秒
ROAD_ROUTES_MAX_SECONDS=12
ROAD_ROUTES_MAX_CALLS=24

# 按模块分模型（可选；未配置则回退主模型）
# 行程规划 Agent（纯文本生成，flash 级即可）
LLM_PLANNER_MODEL=
# 攻略地点提取（结构化提取，小模型更快）
LLM_GUIDE_MODEL=
# PlanPatch 指令解析（结构化翻译，flash 级；追求稳定可换 27b 档）
LLM_PATCH_MODEL=
# 对话收集旅行需求（可选；留空依次使用 PATCH、GUIDE、主模型，不调用规划模型生成行程）
LLM_CHAT_MODEL=
# 截图攻略解析（必须是视觉模型，如 qwen3.8-omni-flash；非视觉模型会导致截图导入不可用）
LLM_VISION_MODEL=

# ============================================================
# Redis 双轨（队列/任务状态/配额/Checkpointer）
# ============================================================
# false：纯内存任务队列，开箱即用；true：需先启动 Redis Stack
# 注意：预算确认/多路线选择的 interrupt 交互仅在 Redis 模式可用
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# 阶段A/B：公共事实缓存，已接入POI/周边搜索与道路路线。默认关闭沿用旧缓存。
# 启用必须配置CACHE_REDIS_URL；不可用时无缓存POI请求稍后重试，路线明确估算，不直穿上游。
# 独立于REDIS_ENABLED；不填写URL时不偷偷使用任务Redis。
CACHE_ENABLED=false
CACHE_REDIS_URL=
CACHE_MAX_CONNECTIONS=16
CACHE_CONNECT_TIMEOUT_SECONDS=0.3
CACHE_READ_TIMEOUT_SECONDS=0.3
CACHE_FAILURE_COOLDOWN_SECONDS=5
CACHE_L1_TTL_SECONDS=30
CACHE_L1_MAX_ENTRIES=512
CACHE_L1_MAX_BYTES=8388608
CACHE_MAX_VALUE_BYTES=262144
CACHE_REBUILD_LEASE_SECONDS=45
CACHE_REBUILD_MAX_SECONDS=90
CACHE_REBUILD_WAIT_SECONDS=3
CACHE_REBUILD_MAX_LOCAL=128
# 上游保护独立于缓存开关；REDIS_ENABLED=true用可靠状态Redis，否则仅单进程保护。
PROVIDER_MAP_CONCURRENCY=3
PROVIDER_LLM_CONCURRENCY=4
PROVIDER_MAP_INTERVAL_SECONDS=0.35
PROVIDER_LLM_INTERVAL_SECONDS=0.1
PROVIDER_WAIT_SECONDS=3
# 队列容量按保守口径包含运行/重试/等待确认任务；消息流另有相同容量上限。
JOB_USER_ACTIVE_LIMIT=2
JOB_GLOBAL_ACTIVE_LIMIT=32
JOB_QUEUE_CAPACITY=32
JOB_ADMISSION_MAX_AGE_SECONDS=3600
JOB_MAX_QUEUE_WAIT_SECONDS=120
# 生产环境需独立缓存实例；仅换逻辑DB不构成内存/淘汰策略隔离。
# 每客户端每日提交上限（0 表示不限；仅 Redis 模式生效）
PLAN_QUOTA_PER_DAY=20
# 每客户端每日攻略解析上限（每次解析 = 1 次 LLM + 多次高德查询）
GUIDE_QUOTA_PER_DAY=20
# 每客户端每日对话轮数，独立于规划和攻略配额
CHAT_QUOTA_PER_DAY=100

# ============================================================
# 服务与前端
# ============================================================
HOST=0.0.0.0
PORT=8000
# 旅行日期校验使用的业务时区
APP_TIMEZONE=Asia/Shanghai
# HTTPS 正式部署时开启；目前 HTTP + 公网 IP 调试保持 false
AUTH_COOKIE_SECURE=false
# CORS配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# 日志级别
LOG_LEVEL=INFO

# ============================================================
# 第三方服务
# ============================================================
# Unsplash API Credentials（景点图片兜底图源）
UNSPLASH_ACCESS_KEY=""
UNSPLASH_SECRET_KEY=""

# 高德地图API配置
AMAP_API_KEY=your_amap_api_key_here

# 地图工具：部署时先运行 python -m app.services.mcp_setup prepare
# 普通启动只用离线依赖缓存；这里的“离线”不影响运行时查询真实地图数据
MCP_WARMUP_ON_STARTUP=true
MCP_POOL_SIZE=4
MCP_STARTUP_TIMEOUT=120
# 可选镜像；留空遵循 uv 配置。改变镜像/缓存目录后需重新 prepare
MCP_PACKAGE_INDEX=

# 百度智能搜索生成（高性能版）：不是裸搜索，也不是普通智能搜索生成。
# 到百度千帆开通该服务后填写 API Key；只填 Key，不要填写 Bearer 前缀。
BAIDU_SEARCH_ENABLED=true
BAIDU_SEARCH_API_KEY=
# 本项目高性能版每天最多实际请求90次；失败也保守计数，缓存命中不占次数。0=禁止新请求。
# 此上限不统计其他项目、控制台调试或其他服务器的调用，实际费用以百度控制台为准。
BAIDU_SEARCH_DAILY_LIMIT=90
BAIDU_SEARCH_TIMEOUT_SECONDS=45
BAIDU_SEARCH_CACHE_HOURS=24

# 高性能版90次用完后切普通版；普通版搜索有免费额度，模型费用另算。
BAIDU_SEARCH_STANDARD_ENABLED=true
BAIDU_SEARCH_STANDARD_DAILY_LIMIT=90
# 百度千帆模型名，需账号已开通；不是当前其他厂商的模型 ID。
BAIDU_SEARCH_STANDARD_MODEL=deepseek-v4-flash
