# ============================================================
# LLM 配置（OpenAI 兼容端点，如阿里云 MaaS）
# ============================================================
# 主模型（研究类 Agent 与默认兜底）
LLM_MODEL_ID=your-model-name
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=your-api-base-url
# 超时时间（可选，默认60秒）
LLM_TIMEOUT=60
# 多日行程JSON较长，低于8192容易被截断并触发降级
LLM_MAX_TOKENS=8192

# 按模块分模型（可选；未配置则回退主模型）
# 行程规划 Agent（纯文本生成，flash 级即可）
LLM_PLANNER_MODEL=
# 攻略地点提取（结构化提取，小模型更快）
LLM_GUIDE_MODEL=
# PlanPatch 指令解析（结构化翻译，flash 级；追求稳定可换 27b 档）
LLM_PATCH_MODEL=
# 截图攻略解析（必须是视觉模型，如 qwen3.8-omni-flash；非视觉模型会导致截图导入不可用）
LLM_VISION_MODEL=

# ============================================================
# Redis 双轨（队列/任务状态/配额/Checkpointer）
# ============================================================
# false：纯内存任务队列，开箱即用；true：需先启动 Redis Stack
# 注意：预算确认/多路线选择的 interrupt 交互仅在 Redis 模式可用
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
# 每客户端每日提交上限（0 表示不限；仅 Redis 模式生效）
PLAN_QUOTA_PER_DAY=20
# 每客户端每日攻略解析上限（每次解析 = 1 次 LLM + 多次高德查询）
GUIDE_QUOTA_PER_DAY=20

# ============================================================
# 服务与前端
# ============================================================
HOST=0.0.0.0
PORT=8000
# 旅行日期校验使用的业务时区
APP_TIMEZONE=Asia/Shanghai
# CORS配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# 日志级别
LOG_LEVEL=INFO

# ============================================================
# 第三方服务
# ============================================================
# Unsplash API Credentials（景点图片兜底图源）
UNSPLASH_ACCESS_KEY=""
UNSPLASH_SECRET_KEY=""

# 高德地图API配置
AMAP_API_KEY=your_amap_api_key_here
