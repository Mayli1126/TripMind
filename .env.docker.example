# 复制为 .env.docker，填写后仅保留在本机；所有命令加 --env-file .env.docker。
TRIPMIND_BIND_IP=127.0.0.1
TRIPMIND_PORT=8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
AUTH_COOKIE_SECURE=false
APP_TIMEZONE=Asia/Shanghai

LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://your-provider.example/v1
LLM_MODEL_ID=your-model-name
LLM_PLANNER_MODEL=
LLM_CHAT_MODEL=
LLM_PATCH_MODEL=
LLM_GUIDE_MODEL=
LLM_VISION_MODEL=
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=60

# 服务端 Web 服务 Key，不会进入前端镜像。
AMAP_API_KEY=your_amap_web_service_key
# 公开的浏览器 JS API Key；修改后重建 frontend。
VITE_AMAP_WEB_JS_KEY=
MCP_WARMUP_ON_STARTUP=true
MCP_POOL_SIZE=4
MCP_STARTUP_TIMEOUT=120
MCP_PACKAGE_INDEX=
SKELETON_DIRECT_ENABLED=true
PLANNING_TIPS_MODE=rules
PLANNING_JOB_TIMEOUT_SECONDS=900
PLAN_QUOTA_PER_DAY=20
GUIDE_QUOTA_PER_DAY=20
CHAT_QUOTA_PER_DAY=100
LOG_LEVEL=INFO

# 百度智能搜索生成（高性能版）：不是裸搜索，也不是普通智能搜索生成。
# 到百度千帆开通该服务后填写 API Key；只填 Key，不要填写 Bearer 前缀。
BAIDU_SEARCH_ENABLED=true
BAIDU_SEARCH_API_KEY=
# 本项目高性能版每天最多实际请求90次；失败也保守计数，缓存命中不占次数。0=禁止新请求。
# 此上限不统计其他项目、控制台调试或其他服务器的调用，实际费用以百度控制台为准。
BAIDU_SEARCH_DAILY_LIMIT=90
BAIDU_SEARCH_TIMEOUT_SECONDS=45
BAIDU_SEARCH_CACHE_HOURS=24

# 高性能版90次用完后切普通版；普通版搜索有免费额度，模型费用另算。
BAIDU_SEARCH_STANDARD_ENABLED=true
BAIDU_SEARCH_STANDARD_DAILY_LIMIT=90
# 百度千帆模型名，需账号已开通；不是当前其他厂商的模型 ID。
BAIDU_SEARCH_STANDARD_MODEL=deepseek-v4-flash
