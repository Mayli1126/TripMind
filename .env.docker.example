# 复制为 .env.docker，填写后仅保留在本机；所有命令加 --env-file .env.docker。
TRIPMIND_BIND_IP=127.0.0.1
TRIPMIND_PORT=8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
AUTH_COOKIE_SECURE=false
APP_TIMEZONE=Asia/Shanghai

LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://your-provider.example/v1
LLM_MODEL_ID=your-model-name
LLM_PLANNER_MODEL=
LLM_CHAT_MODEL=
LLM_PATCH_MODEL=
LLM_GUIDE_MODEL=
LLM_VISION_MODEL=
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=60

# 服务端 Web 服务 Key，不会进入前端镜像。
AMAP_API_KEY=your_amap_web_service_key
# 公开的浏览器 JS API Key；修改后重建 frontend。
VITE_AMAP_WEB_JS_KEY=
MCP_WARMUP_ON_STARTUP=true
MCP_POOL_SIZE=4
MCP_STARTUP_TIMEOUT=120
MCP_PACKAGE_INDEX=
SKELETON_DIRECT_ENABLED=true
PLANNING_TIPS_MODE=rules
PLANNING_JOB_TIMEOUT_SECONDS=900
PLAN_QUOTA_PER_DAY=20
GUIDE_QUOTA_PER_DAY=20
CHAT_QUOTA_PER_DAY=100
LOG_LEVEL=INFO
